---
// ロゴマーク（public/mark.svg をインラインで、currentColor で描く）
import fs from 'node:fs';
interface Props { class?: string; width: number; }
const { class: cls = '', width } = Astro.props;
const raw = fs.readFileSync('public/mark.svg', 'utf8');
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
const height = Math.round((width * 120) / 200);
---
<svg class={cls} width={width} height={height} viewBox="0 0 200 120" role="img" aria-label="貝 — ワニ口クリップと、ピッチが下がりながら減衰する波" set:html={inner} />
