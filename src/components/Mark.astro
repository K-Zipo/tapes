---
// ロゴマーク（public/mark.svg をインラインで、currentColor で描く）。正方形
import fs from 'node:fs';
interface Props { class?: string; size: number; }
const { class: cls = '', size } = Astro.props;
const raw = fs.readFileSync('public/mark.svg', 'utf8');
const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 120 120';
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg class={cls} width={size} height={size} viewBox={viewBox} role="img" aria-label="貝 — ワニ口クリップと、そこから伸びるケーブルが、ピッチを下げながら減衰する波になる" set:html={inner} />
