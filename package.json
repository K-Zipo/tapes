{
  "name": "kai-site",
  "private": true,
  "type": "module",
  "scripts": {
    "notes": "node --env-file-if-exists=.env scripts/notes.mjs",
    "predev": "node --env-file-if-exists=.env scripts/notes.mjs --if-exists",
    "dev": "astro dev",
    "prebuild": "node --env-file-if-exists=.env scripts/notes.mjs --if-exists",
    "build": "astro build",
    "preview": "astro preview",
    "release": "node scripts/release.mjs",
    "sounds": "npm run notes -- --if-exists && node --env-file-if-exists=.env scripts/sounds.mjs",
    "sounds:local": "npm run notes -- --if-exists && node --env-file-if-exists=.env scripts/sounds.mjs --local"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "astro": "^7.4.7",
    "image-size": "^2.1.0",
    "sharp": "^0.35.5"
  }
}
