# .env にコピーして値を入れる（.env は git に入れない）

# Obsidian vault の場所（省略時は iCloud の「貝」）
# NOTES_DIR=/Users/kai/Library/Mobile Documents/iCloud~md~obsidian/Documents/貝

# 音源の置き場所（iCloud の外。省略時は ~/Music/貝）
# SOUNDS_DIR=/Users/kai/Music/貝

# ---- 音源の配信（Cloudflare R2）----
# R2 のバケットの公開URL（末尾スラッシュなし）。
# バケットの Settings → Public access で r2.dev を有効にするか、独自ドメインをつなぐ。
SOUNDS_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# 変換後の .cache/sounds/ をバケットへ送るコマンド（同じファイルは送り直さない）
SOUNDS_UPLOAD_CMD=rclone copy .cache/sounds r2:kai-sounds

# rclone の接続先「r2」。設定ファイルを作らず、ここの環境変数だけで使う。
# R2 → Manage R2 API Tokens で「Object Read & Write」のトークンを作り、表示された値を入れる。
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<アカウントID>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
